# AgentClassroom Environment Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=8787
NODE_ENV=development

# Playwright Configuration
# Set to 1 to skip Playwright browser installation during startup
SKIP_PLAYWRIGHT_INSTALL=0

# Build Configuration
# Set to 1 to only build without starting the server
BUILD_ONLY=0

# Force dependency installation
FORCE_INSTALL=0

# Node.js Memory Configuration (for large pages)
# NODE_OPTIONS=--max-old-space-size=4096
